# Copy to .env for local dev. NEVER commit the real .env.

# --- AI explanations (set at least one; falls back to a rule-based text if none) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# --- Admin panel ---
ADMIN_PASSWORD=change-me
SECRET_KEY=change-me-too

# --- Optional BigQuery (off by default; CSV is used otherwise) ---
USE_BIGQUERY=false
GOOGLE_CLOUD_PROJECT=

# --- Road routing (real road geometry) ---
# Free public OSRM demo server by default; point at your own OSRM for production.
OSRM_URL=https://router.project-osrm.org
# Set to 'network' to force the old built-in road model (offline demo).
ROUTING_ENGINE=osrm
